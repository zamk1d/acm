DEBUG=true

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# true is correct behind an https tunnel (TikTok requires https redirect URI anyway)
SESSION_HTTPS_ONLY=true

# Used when running outside docker. docker-compose overrides the host to `db`.
DATABASE_URL=postgresql+asyncpg://acm:acm@localhost:5432/acm

# TikTok for Developers -> Manage apps -> your app
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# must exactly match the Redirect URI registered in Login Kit (web)
TIKTOK_REDIRECT_URI=https://your-tunnel.example.com/auth/tiktok/callback

# comma separated; each scope must be added to your app in the portal
TIKTOK_SCOPES=user.info.basic